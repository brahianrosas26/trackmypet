{
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(registro|verificar-email|iniciar-sesion|recuperar-clave|restablecer-clave|mis-mascotas)", "dest": "/accounts.html" },
    { "src": "/perdidas", "dest": "/perdidas.html" },
    { "src": "/api/.*", "status": 404 },
    { "src": "/.*", "dest": "/index.html" }
  ],
  "functions": {
    "api/tag.js": { "maxDuration": 30 },
    "api/account.js": { "maxDuration": 30 },
    "api/auth-config.js": { "maxDuration": 15 },
    "api/lost-tags.js": { "maxDuration": 15 },
    "api/sighting.js": { "maxDuration": 15 }
  }
}
