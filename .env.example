SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-do-not-commit
SUPABASE_PUBLISHABLE_KEY=public-browser-key-for-auth-only
# Preview deployments are read-only unless restricted to a disposable test TAG.
TRACKMYPET_PREVIEW_TEST_CODE=
TRACKMYPET_LOST_STATUS_ENABLED=false
TRACKMYPET_PROFILE_FIELDS_ENABLED=false
# Keep false in production until the owner-account Preview has been approved.
TRACKMYPET_ACCOUNTS_ENABLED=false

